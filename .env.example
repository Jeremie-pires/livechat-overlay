APP_ENV=development
NODE_ENV=development
PORT=3000
LOG=info
I18N=fr
DEFAULT_DURATION=5
HIDE_COMMANDS_DISABLED=false

API_URL=http://localhost:3000
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OWNER_ID=
DATABASE_URL="file:./sqlite.db"

# Optional: Cobalt self-hosted instance for TikTok/Twitter video extraction
# COBALT_API_URL — server-to-Cobalt internal URL (e.g. http://cobalt:9000 in Docker)
# COBALT_PUBLIC_URL — browser-accessible Cobalt URL (used as Cobalt's own API_URL env var)
# Leave unset to disable Cobalt (TikTok/Twitter will use iframe fallback)
COBALT_API_URL=http://localhost:9000
COBALT_PUBLIC_URL=http://localhost:9000
